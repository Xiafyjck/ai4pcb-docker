# boxctl 配置。装在 /root/.boxctl.env，直接 vim 改，改完 `boxctl config` 校验一遍。
#
# 只有一个入口：没有 `boxctl config set`。多一个入口就多一套优先级规则，以及出错时
# 「到底哪个生效了」的困惑。
#
# 每一项都直接指向一个具体路径，不靠「都在同一个目录下」这类约定——那是 vpn.py 早期把
# 代码和数据放在一起时的形状，不该往上传染。
#
# 这里只管服务。改 PATH、缓存目录、工具链开关这些是你自己的事，写进 /root/.bashrc
# 就行——它跨重启在。
#
# 路径都填共享卷上的绝对路径：容器可写层重启即丢，跨机器还要求两边路径完全一致。
# 本文件是被 source 的，路径里有空格就自己加引号。

# ---------------------------------------------------------------- 开关
# 登录时 boxctl boot 只会拉起这里打开、且当前没在跑的服务。
BOXCTL_ENABLE_VPN=0
BOXCTL_ENABLE_FSFERRY=0

# ---------------------------------------------------------------- 通用
# 运行时产物的根，各服务在底下自建子目录（vpn 的 SSH 主机密钥、geoip 缓存、日志都在这）。
# 必须在共享卷上：主机密钥要跨重启保持不变，否则客户端每次都撞上
# REMOTE HOST IDENTIFICATION HAS CHANGED。boxctl 自己的 boot 日志也写这。
BOXCTL_STATE_DIR=

# 允许登录本容器的客户端公钥文件。
BOXCTL_SSH_PUBKEY=

# ---------------------------------------------------------------- vpn
# wg 配置文件。它同时决定「本容器是谁」——实例名取文件名（cz4090.conf -> cz4090），
# 运行时目录和 supervisor 的控制 socket 都挂在那个名字底下。多个容器共用同一个共享卷
# 时各指各的那份。
BOXCTL_WG_CONF=

# clash 订阅文件，必须指到具体那一份。留空 = 不起 mihomo，只要隧道不要代理。
#
# 不做「扫目录认领唯一 yaml」：那是 vpn.py 早期代码和数据同处一个文件夹时的产物，多放
# 一份订阅就会突然罢工，报出来的目录还未必是你以为的那个。
BOXCTL_CLASH_CONF=

# ---------------------------------------------------------------- fsferry
# 通道目录，两台机器必须是同一个绝对路径。这个确实是目录而非文件：通道靠目录里的消息
# 文件收发。挑最快的卷，通道本身只占几 KB。
BOXCTL_FSFERRY_DIR=
